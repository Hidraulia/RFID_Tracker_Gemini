<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:padding="@dimen/layout_padding_15" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="horizontal" android:paddingTop="@dimen/layout_padding_15" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="@dimen/text_size_20" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cus_lock_area" android:textAlignment="center" />
        <Spinner android:entries="@array/cus_gjb_lock_group" android:id="@id/cus_gjb_lock_area" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/layout_marginTop_10">
        <TextView android:textSize="@dimen/text_size_20" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/operaType" android:textAlignment="center" />
        <Spinner android:entries="@array/cus_gjb_lock_operation" android:id="@id/cus_gjb_lock_type" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <Button android:layout_gravity="right" android:id="@id/cus_gjb_lock_event" android:layout_width="@dimen/layout_width_100" android:layout_height="wrap_content" android:text="@string/lock" android:textAllCaps="false" />
</LinearLayout>
