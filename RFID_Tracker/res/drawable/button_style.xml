<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <stroke android:width="1.0dp" android:color="#a0a0a0" />
            <corners android:radius="10.0dp" />
            <padding android:left="10.0dp" android:top="10.0dp" android:right="10.0dp" android:bottom="10.0dp" />
            <solid android:color="#b0c4de" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.0dp" android:color="#a0a0a0" />
            <corners android:radius="10.0dp" />
            <solid android:color="#ffffff" />
        </shape>
    </item>
</selector>
